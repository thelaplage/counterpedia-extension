{
  "manifest_version": 3,
  "name": "Counterpedia (Draft-from-source Dev)",
  "version": "0.1.0",
  "description": "Counterpedia extension — local draft-from-source dev build. Connects to the 127.0.0.1:8787 acquisition loopback and the 127.0.0.1:8788 authoring loopback only. A draft is a separate explicit act over an already-captured source; it never admits or publishes.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://127.0.0.1:8788/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Counterpedia"
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "_acquisition_dev": true,
  "_acquisition_endpoint": "http://127.0.0.1:8787",
  "_authoring_dev": true,
  "_authoring_endpoint": "http://127.0.0.1:8788",
  "_three_acts": [
    "1. capture (browser observation, explicit click)",
    "2. acquisition (producer re-fetch -> UNADMITTED receipt, 8787)",
    "3. draft-from-source (proposal_only handoff, 8788) — separate explicit act, never admission"
  ],
  "_privacy_audit": {
    "passive_capture": false,
    "cookies": false,
    "history": false,
    "telemetry": false,
    "form_values": false,
    "all_urls_permission": false,
    "acquisition_host_permission": "http://127.0.0.1:8787/* only",
    "authoring_host_permission": "http://127.0.0.1:8788/* only",
    "capture_requires_explicit_click": true,
    "draft_requires_separate_explicit_click": true,
    "draft_is_proposal_only_never_admission": true,
    "transport_token_is_transport_auth_only": true
  }
}
