{
  "manifest_version": 3,
  "name": "Counterpedia (Draft-from-source Dev)",
  "version": "0.1.0",
  "key": "",
  "_key_note": "SELF-LOAD0: deterministic dev/demo extension id for the self-loading Chrome-for-Testing demo browser ONLY. Public key corresponds to the private key at tools/counterpedia-local/.self-load-key.pem (gitignored, never committed). Computed stable extension id = pplkafbhcmojbomkbieppifcfokpmhpn. Do NOT copy this key into manifest.json (production).",
  "description": "Counterpedia extension — local historical draft-from-source dev build. Connects only to loopback services. Capture, acquisition, drafting, and Counterpedia reader projection remain separate acts; drafting reuses the retained historical capture and never admits or publishes.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "pageCapture"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://127.0.0.1:8788/*",
    "http://127.0.0.1:8790/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Counterpedia"
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "_acquisition_dev": true,
  "_acquisition_endpoint": "http://127.0.0.1:8787",
  "_authoring_dev": true,
  "_authoring_endpoint": "http://127.0.0.1:8788",
  "_local_companion_dev": true,
  "_local_companion_endpoint": "http://127.0.0.1:8790",
  "_counterpedia_reader_dev": true,
  "_counterpedia_reader_endpoint": "http://127.0.0.1:3000/api/counterpedia/reader/proposal",
  "_three_acts": [
    "1. capture (browser observation, explicit click)",
    "2. acquisition (producer re-fetch -> retained exact bytes + UNADMITTED receipt, 8787)",
    "3. draft-from-source (reprocess retained historical capture -> proposal_only handoff, 8788) — separate explicit act, zero live source fetch, never admission"
  ],
  "_reader_projection": "post-authoring product projection only; no acquisition, no authoring, no admission",
  "_privacy_audit": {
    "passive_capture": false,
    "cookies": false,
    "history": false,
    "telemetry": false,
    "form_values": false,
    "all_urls_permission": false,
    "page_capture_permission": "explicit operator MHTML snapshot only",
    "acquisition_host_permission": "http://127.0.0.1:8787/* only",
    "authoring_host_permission": "http://127.0.0.1:8788/* only",
    "local_companion_host_permission": "http://127.0.0.1:8790/* only",
    "counterpedia_reader_host_permission": "http://127.0.0.1:3000/* only",
    "capture_requires_explicit_click": true,
    "operator_snapshot_requires_explicit_click": true,
    "draft_requires_separate_explicit_click": true,
    "draft_reuses_retained_capture": true,
    "draft_live_source_fetch": false,
    "draft_is_proposal_only_never_admission": true,
    "reader_projection_is_post_authoring_only": true,
    "transport_token_is_transport_auth_only": true,
    "acquisition_token_storage": "chrome.storage.session",
    "pairing_is_transport_configuration_only": true
  }
}
